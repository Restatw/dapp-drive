# Copy this file to .env and fill in the values

# IPFS node address (keep this pointing to localhost — never expose 5001 to the internet)
IPFS_API=http://127.0.0.1:5001

# Proxy listen address
PORT=3000
HOST=0.0.0.0

# Comma-separated list of browser origins allowed to call this proxy
# Add your IPNS gateway URLs here after first deploy
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Per-user limits (bytes)
MAX_FILE_BYTES=104857600    # 100 MB per file
MAX_USER_BYTES=5368709120   # 5 GB per user
