# Production — all IPFS calls go through the proxy server.
# The proxy handles JWT auth and quota enforcement.
# Replace the URL below with your actual proxy domain/IP.
VITE_IPFS_API=https://your-proxy-domain.com
VITE_IPFS_GW=https://your-proxy-domain.com
VITE_USE_PROXY=true
VITE_PROXY_URL=https://your-proxy-domain.com
